#!/usr/bin/env bash
set -e

USER_HOME="${USER_HOME:-"/home/$USER"}"
DOTFILES_DIR="${DOTFILES_DIR:-$USER_HOME/.dotfiles}"

. "$DOTFILES_DIR/coreconfig/helpers.sh"

require_vars XDG_CACHE_HOME SCRIPTS_DIR

. "$SCRIPTS_DIR/packages/install_helpers.sh"

CACHE_DIR="$XDG_CACHE_HOME/yazi-installer"
ARCHIVE="$CACHE_DIR/yazi-x86_64-unknown-linux-gnu.zip"
INSTALL_DIR="/opt/yazi"

mkdir -p "$CACHE_DIR"

echo "Downloading latest Yazi (x86_64)..."

URL="https://github.com/sxyazi/yazi/releases/latest/download/yazi-x86_64-unknown-linux-gnu.zip"

download "$ARCHIVE" "$URL"

WORKDIR=$(create_work_dir)

trap 'cleanup "$WORKDIR"' EXIT

echo "Extracting..."
ex "$ARCHIVE" --outdir "$WORKDIR"

if [ ! -d "$WORKDIR/yazi-x86_64-unknown-linux-gnu" ]; then
  print_err "Unexpected archive layout, aborting"
fi

mv "$WORKDIR/yazi-x86_64-unknown-linux-gnu" "$WORKDIR/yazi"

echo "Installing to $INSTALL_DIR..."

run_root rm -rf $INSTALL_DIR
run_root mv "$WORKDIR/yazi" "$INSTALL_DIR"

if [ ! -f "$INSTALL_DIR/yazi" ]; then
  print_err "Unexpected archive layout, aborting"
fi

if [ ! -f "$INSTALL_DIR/ya" ]; then
  print_err "Unexpected archive layout, aborting"
fi

echo "Creating symlink /usr/local/bin/yazi..."

run_root ln -sf "$INSTALL_DIR/yazi" /usr/local/bin/yazi

echo "Creating symlink /usr/local/bin/ya..."

run_root ln -sf "$INSTALL_DIR/ya" /usr/local/bin/ya

COMPLETIONS_DIR="$INSTALL_DIR/completions"

if [ -d "$COMPLETIONS_DIR" ]; then
  echo "Installing shell completions..."

  run_root mkdir -p /usr/share/bash-completion/completions
  [ -f "$COMPLETIONS_DIR/yazi.bash" ] &&
    run_root ln -sf "$COMPLETIONS_DIR/yazi.bash" /usr/share/bash-completion/completions/yazi
  [ -f "$COMPLETIONS_DIR/ya.bash" ] &&
    run_root ln -sf "$COMPLETIONS_DIR/ya.bash" /usr/share/bash-completion/completions/ya
fi

echo "Cleaning cache..."
rm -rf "$CACHE_DIR"

echo "Done"
