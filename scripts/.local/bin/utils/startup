#!/usr/bin/env bash
set -e

USER_HOME="${USER_HOME:-"/home/$USER"}"
DOTFILES_DIR="${DOTFILES_DIR:-$USER_HOME/.dotfiles}"

. "$DOTFILES_DIR/coreconfig/helpers.sh"

load_desktop_env -e

run() {
  if pgrep -x bluetoothd >/dev/null 2>&1; then
    bluetooth_menu --off
  fi
  toggle_touchscreen --off
  touchpad_setup
  trackpoint_setup
}

if [ "$1" == "--force" ]; then
  run
  exit 0
fi

if [ ! -f "/tmp/startuplock" ]; then
  run
  touch "/tmp/startuplock"
fi
