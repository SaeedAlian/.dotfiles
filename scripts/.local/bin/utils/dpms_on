#!/usr/bin/env bash
set -e

USER_HOME="${USER_HOME:-"/home/$USER"}"
DOTFILES_DIR="${DOTFILES_DIR:-$USER_HOME/.dotfiles}"

. "$DOTFILES_DIR/coreconfig/helpers.sh"

require_vars START_LOCKSCREEN_SCRIPT_PATH

SCREEN_TIMEOUT=${SCREEN_TIMEOUT:-600}

xset s $SCREEN_TIMEOUT $SCREEN_TIMEOUT
xset +dpms dpms 0 0 $SCREEN_TIMEOUT
pgrep -x xss-lock >/dev/null || xss-lock -l -- $START_LOCKSCREEN_SCRIPT_PATH &

if [ $? == 0 ]; then
  DISPLAY=:0.0 notify-send --expire-time=2000 "DPMS turned on"
fi
