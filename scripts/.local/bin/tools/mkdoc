#!/usr/bin/env bash
set -e

USER_HOME="${USER_HOME:-"/home/$USER"}"
DOTFILES_DIR="${DOTFILES_DIR:-$USER_HOME/.dotfiles}"

. "$DOTFILES_DIR/coreconfig/helpers.sh"

require_vars GITHUB_USERNAME \
    PROJECTS_DIR \
    NOTES_DIR \
    WORK_DIR \
    STUDY_DIR

need_bin tmux

NOTES_PREFIX="${TMUX_FZF_SESSION_NOTES_PREFIX:-note}"
WORK_PREFIX="${TMUX_FZF_SESSION_WORK_PREFIX:-work}"
STUDY_PREFIX="${TMUX_FZF_SESSION_STUDY_PREFIX:-study}"
PROJECTS_PREFIX="${TMUX_FZF_SESSION_PROJECTS_PREFIX:-proj}"

print_help() {
    echo "Document Creator"
    echo ""
    echo "Usage:"
    echo "  $(basename "$0") [Type] [OPTIONS]"
    echo ""
    echo "Types:"
    echo "  work             Create work directory at $WORK_DIR"
    echo ""
    echo "  project          Create project directory at $PROJECTS_DIR"
    echo ""
    echo "  study            Create study directory at $STUDY_DIR"
    echo ""
    echo "  note             Create note directory at $NOTES_DIR"
    echo ""
    echo "Options:"
    echo "  -h, --help       Show this help message and exit"
    echo ""
    echo "Description:"
    echo "  This script creates a new document based on the [Type]."
    echo ""
    echo "  After creating the directory, it will start or attach a tmux session for the document directory."
    echo ""
}

check_dirname() {
    dirname="$1"
    dirname="$(printf '%s' "$dirname" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    if [ -z "$dirname" ]; then
        print_err "Directory name is empty"
    fi

    if grep -q '[\\/:*?"<>|;]' <<<"$dirname"; then
        print_err "Invalid directory name, it contains illegal characters"
    fi

    if [[ "$dirname" =~ ^[-_] ]]; then
        print_err "Directory name must not start with '-' or '_'"
    fi

    if [[ "$dirname" == "." ]] || [[ "$dirname" == ".." ]]; then
        print_err "Directory name must not be '.' or '..'"
    fi

    if [[ "$dirname" == *"$'\0'"* ]]; then
        print_err "Directory name contains null bytes"
    fi

    if [[ ${#dirname} -gt 255 ]]; then
        print_err "Directory name exceeds 255 characters"
    fi

    printf '%s' "$dirname"
}

create_dir() {
    base_dirname="$1"
    dirname="$2"

    if [ -d "$base_dirname/$dirname" ]; then
        print_err "Another directory with this name already exists!"
    fi

    mkdir -p "$base_dirname/$dirname"
    echo "Created directory: $base_dirname/$dirname"
}

append_gitignore() {
    if [ "$#" -gt 0 ]; then
        printf '%s\n' "$@" >>.gitignore
    fi
    printf '.personal_temp/\npersonal_temp/\ntemp/\n' >>.gitignore
}

setup_react() {
    need_bin yarn
    yarn create vite "$project_name" --template react
    cd "$project_name" || exit 1
    [ -f .gitignore ] && append_gitignore
}

setup_react_ts() {
    need_bin yarn
    yarn create vite "$project_name" --template react-ts
    cd "$project_name" || exit 1
    [ -f .gitignore ] && append_gitignore
}

setup_nextjs() {
    need_bin npx
    npx create-next-app@latest "$project_name"
    cd "$project_name" || exit 1
    [ -f .gitignore ] && append_gitignore
}

setup_rust_bin() {
    need_bin cargo
    cargo init "$project_name" --bin
    cd "$project_name" || exit 1
    [ -f .gitignore ] && append_gitignore
}

setup_go() {
    need_bin go
    cd "$project_name" || exit 1

    go mod init "github.com/$GITHUB_USERNAME/$project_name"
    touch .gitignore

    cat >main.go <<'EOF'
package main

import (
	"fmt"
)

func main() {
	fmt.Println("Hello world")
}
EOF

    cat >Makefile <<EOF
build:
	@go build -o bin/$project_name main.go

test:
	@go test -v ./...

run: build
	@./bin/$project_name
EOF

    append_gitignore ".env" "bin/"
}

setup_c() {
    cd "$project_name" || exit 1
    mkdir src
    touch .gitignore

    cat >src/main.c <<'EOF'
#include <stdio.h>

int main() {
	printf("Hello world\n");
	return 0;
}
EOF

    cat >Makefile <<'EOF'
build:
	@gcc -o main.out src/main.c

debug:
	@gcc -g -o main.out src/main.c && gdb ./main.out

run:
	@./main.out

valgrind: build
	@valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes ./main.out
EOF

    append_gitignore "main.out"
}

setup_cpp() {
    cd "$project_name" || exit 1
    mkdir src
    touch .gitignore

    cat >src/main.cpp <<'EOF'
#include <iostream>

int main() {
	std::cout << "Hello world" << std::endl;
	return 0;
}
EOF

    cat >Makefile <<'EOF'
build:
	@g++ -o main.out src/main.cpp

debug:
	@g++ -g -o main.out src/main.cpp && gdb ./main.out

run:
	@./main.out

valgrind: build
	@valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes ./main.out
EOF

    append_gitignore "main.out"
}

setup_python() {
    need_bin python3
    cd "$project_name" || exit 1
    touch main.py .gitignore

    append_gitignore ".venv" "**/__pycache__/"

    python3 -m venv .venv
}

setup_empty() {
    mkdir "$project_name"
    cd "$project_name" || exit 1
    touch .gitignore
    append_gitignore
}

ask_and_create_project_files() {
    local base_dirname="$1"
    project_name="$2"

    cd "$base_dirname" || exit 1

    local question="What is the project type ??"
    local options=("react" "react-ts" "nextjs" "rust-bin" "c" "go" "cpp" "python" "empty" "cancel")

    select project_type in "${options[@]}"; do
        case "$project_type" in
        "react")
            setup_react
            break
            ;;
        "react-ts")
            setup_react_ts
            break
            ;;
        "go")
            setup_go
            break
            ;;
        "nextjs")
            setup_nextjs
            break
            ;;
        "rust-bin")
            setup_rust_bin
            break
            ;;
        "c")
            setup_c
            break
            ;;
        "cpp")
            setup_cpp
            break
            ;;
        "python")
            setup_python
            break
            ;;
        "empty")
            setup_empty
            break
            ;;
        "cancel") exit 0 ;;
        *) print_err "Invalid option!" ;;
        esac
    done

    cd "$HOME" || exit 1
}

if [[ "$1" == "-h" ]] ||
    [[ "$1" == "--help" ]] ||
    [[ "$2" == "-h" ]] ||
    [[ "$2" == "--help" ]]; then
    print_help
    exit 0
fi

case "$1" in
work)
    base_dir="$WORK_DIR"
    base_prefix="$WORK_PREFIX"
    prompt="Enter the work directory name: "
    ;;

project)
    base_dir="$PROJECTS_DIR"
    base_prefix="$PROJECTS_PREFIX"
    prompt="Enter the project name: "
    ;;

note)
    base_dir="$NOTES_DIR"
    base_prefix="$NOTES_PREFIX"
    prompt="Enter the note directory name: "
    ;;

study)
    base_dir="$STUDY_DIR"
    base_prefix="$STUDY_PREFIX"
    prompt="Enter the study directory name: "
    ;;

*)
    print_err "Invalid option $1"
    ;;
esac

read -e -p "$prompt" doc_dir
doc_dir="$(check_dirname "$doc_dir")"
create_dir "$base_dir" "$doc_dir"

if [[ "$1" == "project" ]]; then
    ask_and_create_project_files "$base_dir" "$doc_dir"
fi

session_name="$base_prefix--$doc_dir"

if ! tmux has-session -t="$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$base_dir/$doc_dir"
fi

if [ -z "$TMUX" ]; then
    tmux attach -t "$session_name"
else
    tmux switch-client -t "$session_name"
fi
