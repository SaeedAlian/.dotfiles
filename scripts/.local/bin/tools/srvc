#!/usr/bin/env bash

USER_HOME="${USER_HOME:-"/home/$USER"}"
DOTFILES_DIR="${DOTFILES_DIR:-$USER_HOME/.dotfiles}"

. "$DOTFILES_DIR/coreconfig/helpers.sh"

require_vars XDG_DATA_HOME

SV_DIRS=(
  "/etc/sv"
  "$XDG_DATA_HOME/sv"
  "/usr/share/runit/sv.now"
)
ACTIVE_DIR="/etc/runit/runsvdir/default"

print_help() {
  help="A simple command-line tool for managing runit services.

Usage: $(basename "$0") [options] [service]

Options:
  -l, --list                List all available services and their status.

  -a, --activate <name>     Activate the specified service.

  -d, --deactivate <name>   Deactivate the specified service.

  -h, --help                Show this help message and exit.

Notes:
 • Services are searched in:
$(printf "   - %s\n" "${SV_DIRS[@]}")

 • Active services are linked into:
   $ACTIVE_DIR
"

  if command -v less >/dev/null 2>&1; then
    echo "$help" | less
  else
    echo "$help"
  fi
}

find_service() {
  local srv="$1"

  for dir in "${SV_DIRS[@]}"; do
    if [ -e "$dir/$srv" ]; then
      echo "$dir/$srv"
      return 0
    fi
  done

  return 1
}

list_services() {
  printf "%-30s | %-10s\n" "Service" "Status"
  printf "%-30s-+-%-10s\n" "------------------------------" "----------"

  declare -A seen

  for dir in "${SV_DIRS[@]}"; do
    [ -d "$dir" ] || continue

    for service in "$dir"/*; do
      [ -e "$service" ] || continue
      name=$(basename "$service")

      if [[ ${seen[$name]} ]]; then
        continue
      fi

      seen[$name]=1

      if [ -L "$ACTIVE_DIR/$name" ]; then
        status="active"
      else
        status="inactive"
      fi

      printf "%-30s | %-10s\n" "$name" "$status"
    done
  done
}

activate_service() {
  local srv="$1"
  service_path=$(find_service "$srv")

  if [ $? -ne 0 ]; then
    print_err "Service not found"
  fi

  if [ -L "$ACTIVE_DIR/$srv" ]; then
    print_err "Service is already active"
  fi

  sudo ln -s "$service_path" "$ACTIVE_DIR"

  echo "Service $srv activated"
}

deactivate_service() {
  local srv="$1"

  if ! [ -L "$ACTIVE_DIR/$srv" ]; then
    print_err "Service is already deactive"
  fi

  sudo rm -rf "$ACTIVE_DIR/$srv"
  echo "Service $srv deactivated"
}

case "$1" in
--list | -l)
  list_services
  ;;
--activate | -a)
  if [ -z "$2" ]; then
    print_err "Service is empty"
  fi
  activate_service "$2"
  ;;
--deactivate | -d)
  if [ -z "$2" ]; then
    print_err "Service is empty"
  fi
  deactivate_service "$2"
  ;;
--help | -h)
  print_help
  ;;
*)
  print_help
  ;;
esac
