local status_line_colors = {
	normal = {
		bg = "${NVIM_COLOR_STATUS_LINE_NORMAL_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_NORMAL_FG}",
	},

	insert = {
		bg = "${NVIM_COLOR_STATUS_LINE_INSERT_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_INSERT_FG}",
	},

	visual = {
		bg = "${NVIM_COLOR_STATUS_LINE_VISUAL_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_VISUAL_FG}",
	},

	visual_line = {
		bg = "${NVIM_COLOR_STATUS_LINE_VISUAL_LINE_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_VISUAL_LINE_FG}",
	},

	visual_block = {
		bg = "${NVIM_COLOR_STATUS_LINE_VISUAL_BLOCK_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_VISUAL_BLOCK_FG}",
	},

	command = {
		bg = "${NVIM_COLOR_STATUS_LINE_COMMAND_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_COMMAND_FG}",
	},

	replace = {
		bg = "${NVIM_COLOR_STATUS_LINE_REPLACE_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_REPLACE_FG}",
	},

	terminal = {
		bg = "${NVIM_COLOR_STATUS_LINE_TERMINAL_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_TERMINAL_FG}",
	},

	dim = {
		bg = "${NVIM_COLOR_STATUS_LINE_DIM_BG}",
		fg = "${NVIM_COLOR_STATUS_LINE_DIM_FG}",
	},
}

local theme_colors = {
	bg0 = "${NVIM_COLOR_THEME_BG0}",
	bg1 = "${NVIM_COLOR_THEME_BG1}",
	bg2 = "${NVIM_COLOR_THEME_BG2}",
	bg3 = "${NVIM_COLOR_THEME_BG3}",
	fg = "${NVIM_COLOR_THEME_FG}",
	fg_dark = "${NVIM_COLOR_THEME_FG_DARK}",
	fg_light = "${NVIM_COLOR_THEME_FG_LIGHT}",

	red = "${NVIM_COLOR_THEME_FG_RED}",
	orange = "${NVIM_COLOR_THEME_FG_ORANGE}",
	yellow = "${NVIM_COLOR_THEME_FG_YELLOW}",
	green = "${NVIM_COLOR_THEME_FG_GREEN}",
	cyan = "${NVIM_COLOR_THEME_FG_CYAN}",
	blue = "${NVIM_COLOR_THEME_FG_BLUE}",
	purple = "${NVIM_COLOR_THEME_FG_PURPLE}",
}

return {
	status_line_colors = status_line_colors,
	theme_colors = theme_colors,
}
